{
  "name": "interview-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for practicing interview answers out loud",
  "scripts": {
    "build": "esbuild src/background.js --bundle --format=esm --platform=browser --target=chrome120 --minify --outfile=extension/background.js",
    "watch": "npm run build -- --watch",
    "test": "node --test \"tests/*.test.*\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
